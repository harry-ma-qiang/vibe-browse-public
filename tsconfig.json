{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "chrome"
    ],
    "skipLibCheck": true
  },
  "include": [
    "core",
    "entrypoints",
    "utils",
    "tests",
    "*.ts",
    "*.js"
  ]
}
